@host = {{host}}
@course_id = 1
@user_course_id = 2

########################################################################
### Список курсов — аноним (видит только OFFICIAL)
GET {{host}}/api/courses
Accept: application/json

########################################################################
### Список курсов — от лица обычного юзера (OFFICIAL + свои USER)
GET {{host}}/api/courses
Accept: application/json
Authorization: Bearer {{user_token}}

########################################################################
### Список курсов — от лица админа (видит вообще всё)
GET {{host}}/api/courses
Accept: application/json
Authorization: Bearer {{admin_token}}

########################################################################
### Получить курс по id
GET {{host}}/api/courses/{{course_id}}
Accept: application/json

########################################################################
### Получить чужой USER-курс анонимно (ожидаем 404, а не 403 — не палим существование)
GET {{host}}/api/courses/{{user_course_id}}
Accept: application/json


########################################################################
############################  СОЗДАНИЕ  ###############################
########################################################################

### Админ создаёт курс — должен стать OFFICIAL
POST {{host}}/api/courses
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "title": "Кыргызский язык: базовый курс",
  "description": "Официальный курс от команды KyrgyzLearn",
  "position": 0
}

########################################################################
### Обычный юзер создаёт курс — должен стать USER, владелец = он сам
POST {{host}}/api/courses
Content-Type: application/json
Authorization: Bearer {{user_token}}

{
  "title": "Мой курс кыргызского для друзей",
  "description": "Персональная подборка уроков"
}

########################################################################
### Создать курс без токена (ожидаем 401)
POST {{host}}/api/courses
Content-Type: application/json

{
  "title": "Курс без авторизации"
}

########################################################################
### Создать курс — без обязательного title (ожидаем 400)
POST {{host}}/api/courses
Content-Type: application/json
Authorization: Bearer {{user_token}}

{
  "description": "Курс без названия"
}


########################################################################
############################  ИЗМЕНЕНИЕ  ##############################
########################################################################

### Владелец меняет свой USER-курс — 200
PATCH {{host}}/api/courses/{{user_course_id}}
Content-Type: application/json
Authorization: Bearer {{user_token}}

{
  "description": "Обновлённое описание моего курса"
}

########################################################################
### Другой юзер пытается изменить чужой USER-курс — ожидаем 403
PATCH {{host}}/api/courses/{{user_course_id}}
Content-Type: application/json
Authorization: Bearer {{other_user_token}}

{
  "description": "Пытаюсь изменить чужой курс"
}

########################################################################
### Обычный юзер пытается изменить OFFICIAL-курс — ожидаем 403
PATCH {{host}}/api/courses/{{course_id}}
Content-Type: application/json
Authorization: Bearer {{user_token}}

{
  "description": "Пытаюсь изменить официальный курс"
}

########################################################################
### Админ меняет OFFICIAL-курс — 200
PATCH {{host}}/api/courses/{{course_id}}
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "description": "Обновлённое описание официального курса"
}


########################################################################
############################  УДАЛЕНИЕ  ###############################
########################################################################

### Владелец удаляет свой курс
DELETE {{host}}/api/courses/{{user_course_id}}
Authorization: Bearer {{user_token}}

########################################################################
### Не-админ пытается удалить OFFICIAL-курс — ожидаем 403
DELETE {{host}}/api/courses/{{course_id}}
Authorization: Bearer {{user_token}}

########################################################################
### Удалить несуществующий курс — ожидаем 404
DELETE {{host}}/api/courses/999
Authorization: Bearer {{admin_token}}
