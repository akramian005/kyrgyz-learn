@host = {{host}}
@course_id = 1
@user_course_id = 2
@lesson_id = 1
@question_id = 1
@option_id = 1
@message_id = 1

########################################################################
### Получить уроки курса (пагинация)
GET {{host}}/api/lessons?courseId={{course_id}}
Accept: application/json

########################################################################
### Получить урок по id
GET {{host}}/api/lessons/{{lesson_id}}
Accept: application/json

########################################################################
### Получить несуществующий урок (ожидаем 404)
GET {{host}}/api/lessons/999
Accept: application/json

########################################################################
### Создать урок в OFFICIAL-курсе — админ, 201
POST {{host}}/api/lessons
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "title": "Урок 1: Приветствие",
  "description": "Базовые фразы для знакомства",
  "position": 0,
  "courseId": {{course_id}}
}

########################################################################
### Создать урок в OFFICIAL-курсе — обычный юзер (ожидаем 403)
POST {{host}}/api/lessons
Content-Type: application/json
Authorization: Bearer {{user_token}}

{
  "title": "Попытка добавить урок в официальный курс",
  "courseId": {{course_id}}
}

########################################################################
### Создать урок в своём USER-курсе — владелец, 201
POST {{host}}/api/lessons
Content-Type: application/json
Authorization: Bearer {{user_token}}

{
  "title": "Мой первый урок",
  "courseId": {{user_course_id}}
}

########################################################################
### Создать урок в чужом USER-курсе (ожидаем 403)
POST {{host}}/api/lessons
Content-Type: application/json
Authorization: Bearer {{other_user_token}}

{
  "title": "Пытаюсь добавить урок в чужой курс",
  "courseId": {{user_course_id}}
}

########################################################################
### Создать урок — без обязательного title (ожидаем 400)
POST {{host}}/api/lessons
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "courseId": {{course_id}}
}

########################################################################
### Создать урок — без courseId (ожидаем 400)
POST {{host}}/api/lessons
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "title": "Урок без курса"
}

########################################################################
### Обновить урок — владелец/админ
PATCH {{host}}/api/lessons/{{lesson_id}}
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "description": "Обновлённое описание урока"
}

########################################################################
### Обновить чужой урок (ожидаем 403)
PATCH {{host}}/api/lessons/{{lesson_id}}
Content-Type: application/json
Authorization: Bearer {{other_user_token}}

{
  "description": "Пытаюсь изменить чужой урок"
}

########################################################################
### Удалить урок
DELETE {{host}}/api/lessons/{{lesson_id}}
Authorization: Bearer {{admin_token}}


########################################################################
########################  ВОПРОСЫ  ####################################
########################################################################

### Добавить вопрос с одним правильным ответом (SINGLE_CHOICE)
POST {{host}}/api/lessons/{{lesson_id}}/questions
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "text": "Как перевести «дом» на английский?",
  "type": "SINGLE_CHOICE",
  "options": [
    { "text": "House", "correct": true },
    { "text": "Dog", "correct": false },
    { "text": "Tree", "correct": false }
  ]
}

########################################################################
### Добавить вопрос с несколькими правильными ответами (MULTIPLE_CHOICE)
POST {{host}}/api/lessons/{{lesson_id}}/questions
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "text": "Выбери все фрукты",
  "type": "MULTIPLE_CHOICE",
  "options": [
    { "text": "Apple", "correct": true },
    { "text": "Car", "correct": false },
    { "text": "Banana", "correct": true }
  ]
}

########################################################################
### Добавить вопрос-последовательность (ORDER)
POST {{host}}/api/lessons/{{lesson_id}}/questions
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "text": "Собери фразу в правильном порядке",
  "type": "ORDER",
  "options": [
    { "text": "I", "correct": false, "correctPosition": 0 },
    { "text": "am", "correct": false, "correctPosition": 1 },
    { "text": "Mark", "correct": false, "correctPosition": 2 },
    { "text": "Kyrgyzstan", "correct": false }
  ]
}

########################################################################
### Добавить вопрос в чужой урок (ожидаем 403)
POST {{host}}/api/lessons/{{lesson_id}}/questions
Content-Type: application/json
Authorization: Bearer {{other_user_token}}

{
  "text": "Пытаюсь добавить вопрос в чужой урок",
  "type": "SINGLE_CHOICE",
  "options": [{ "text": "test", "correct": true }]
}

########################################################################
### Обновить текст вопроса
PATCH {{host}}/api/lessons/{{lesson_id}}/questions/{{question_id}}
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "text": "Как правильно перевести «дом»?"
}

########################################################################
### Обновить вопрос, принадлежащий другому уроку (ожидаем 400)
PATCH {{host}}/api/lessons/999/questions/{{question_id}}
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "text": "Попытка изменить чужой вопрос"
}

########################################################################
### Удалить вопрос
DELETE {{host}}/api/lessons/{{lesson_id}}/questions/{{question_id}}
Authorization: Bearer {{admin_token}}


########################################################################
######################  ВАРИАНТЫ ОТВЕТА  ##############################
########################################################################

### Добавить вариант ответа к существующему вопросу
POST {{host}}/api/lessons/{{lesson_id}}/questions/{{question_id}}/options
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "text": "Cat",
  "correct": false
}

########################################################################
### Обновить вариант ответа — сделать правильным
PATCH {{host}}/api/lessons/{{lesson_id}}/questions/{{question_id}}/options/{{option_id}}
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "correct": true
}

########################################################################
### Удалить вариант ответа
DELETE {{host}}/api/lessons/{{lesson_id}}/questions/{{question_id}}/options/{{option_id}}
Authorization: Bearer {{admin_token}}


########################################################################
####################  СООБЩЕНИЯ-ОБЪЯСНЕНИЯ  ###########################
########################################################################

### Добавить сообщение-объяснение между вопросами
POST {{host}}/api/lessons/{{lesson_id}}/messages
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "text": "Отлично! Теперь разберём глагол to be."
}

########################################################################
### Обновить текст сообщения
PATCH {{host}}/api/lessons/{{lesson_id}}/messages/{{message_id}}
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "text": "Обновлённый текст объяснения"
}

########################################################################
### Удалить сообщение
DELETE {{host}}/api/lessons/{{lesson_id}}/messages/{{message_id}}
Authorization: Bearer {{admin_token}}
