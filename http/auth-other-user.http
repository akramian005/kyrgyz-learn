@host = {{host}}

########################################################################
### OTHER_USER — Регистрация
### Нужен как третий аккаунт для тестов "чужой курс/урок"
### Токен сохраняется в глобальную переменную other_user_token
########################################################################

POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "other@gmail.com",
  "password": "12345678"
}

> {%
    client.global.set("other_user_token", response.body.token);
%}

########################################################################
### OTHER_USER — Логин
###
### Токен сохраняется в глобальную переменную other_user_token
########################################################################

POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "other@gmail.com",
  "password": "12345678"
}

> {%
    client.global.set("other_user_token", response.body.token);
%}
