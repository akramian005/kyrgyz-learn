@lesson_id = 1
@question_id = 1
@message_id = 1

########################################################################
############################  АУДИО ВОПРОСА  ##########################
########################################################################

### Загрузить аудио к вопросу (WAV)
POST {{host}}/api/lessons/{{lesson_id}}/questions/{{question_id}}/audio
Content-Type: multipart/form-data; boundary=WebAppBoundary
Authorization: Bearer {{admin_token}}

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="question.wav"
Content-Type: audio/wav

< audio/question.wav
--WebAppBoundary--


########################################################################
######################  КАРТИНКА И АУДИО СООБЩЕНИЯ  ###################
########################################################################

### Загрузить картинку к сообщению-объяснению
POST {{host}}/api/lessons/{{lesson_id}}/messages/{{message_id}}/image
Content-Type: multipart/form-data; boundary=WebAppBoundary
Authorization: Bearer {{admin_token}}

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="explain.jpeg"
Content-Type: image/jpeg

< images/explain.jpeg
--WebAppBoundary--

########################################################################
### Загрузить аудио к сообщению-объяснению (WAV)
POST {{host}}/api/lessons/{{lesson_id}}/messages/{{message_id}}/audio
Content-Type: multipart/form-data; boundary=WebAppBoundary
Authorization: Bearer {{admin_token}}

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="explain.wav"
Content-Type: audio/wav

< audio/explain.wav
--WebAppBoundary--

########################################################################
#########################  УДАЛЕНИЕ МЕДИА  ############################
########################################################################

### Убрать аудио у вопроса
DELETE {{host}}/api/lessons/{{lesson_id}}/questions/{{question_id}}/audio
Authorization: Bearer {{admin_token}}

########################################################################
### Убрать картинку у сообщения
DELETE {{host}}/api/lessons/{{lesson_id}}/messages/{{message_id}}/image
Authorization: Bearer {{admin_token}}

########################################################################
### Убрать аудио у сообщения
DELETE {{host}}/api/lessons/{{lesson_id}}/messages/{{message_id}}/audio
Authorization: Bearer {{admin_token}}


########################################################################
### Проверить, что все медиа-ссылки появились в уроке
GET {{host}}/api/lessons/{{lesson_id}}
Accept: application/json
