@host = {{host}}
@lesson_id = 1
@question_id = 1
@option_id = 1
@message_id = 1

########################################################################
############################  АУДИО ВОПРОСА  ##########################
########################################################################

### Загрузить аудио к вопросу
POST {{host}}/api/lessons/{{lesson_id}}/questions/{{question_id}}/audio
Content-Type: multipart/form-data; boundary=WebAppBoundary
Authorization: Bearer {{admin_token}}

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="question.mp3"
Content-Type: audio/mpeg

< audio/question.wav
--WebAppBoundary--

########################################################################
### Загрузить аудио — не аудиофайл (ожидаем 400)
POST {{host}}/api/lessons/{{lesson_id}}/questions/{{question_id}}/audio
Content-Type: multipart/form-data; boundary=WebAppBoundary
Authorization: Bearer {{admin_token}}

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="document.txt"
Content-Type: text/plain

Это не аудио
--WebAppBoundary--

########################################################################
### Загрузить аудио к несуществующему вопросу (ожидаем 404)
POST {{host}}/api/lessons/{{lesson_id}}/questions/999/audio
Content-Type: multipart/form-data; boundary=WebAppBoundary
Authorization: Bearer {{admin_token}}

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="question.mp3"
Content-Type: audio/mpeg

< audio/question.mp3
--WebAppBoundary--

########################################################################
### Загрузить аудио к вопросу в чужом уроке (ожидаем 403)
POST {{host}}/api/lessons/{{lesson_id}}/questions/{{question_id}}/audio
Content-Type: multipart/form-data; boundary=WebAppBoundary
Authorization: Bearer {{other_user_token}}

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="question.mp3"
Content-Type: audio/mpeg

< audio/question.mp3
--WebAppBoundary--


########################################################################
########################  КАРТИНКА ВАРИАНТА ОТВЕТА  ###################
########################################################################

### Загрузить картинку к варианту ответа
POST {{host}}/api/lessons/{{lesson_id}}/questions/{{question_id}}/options/{{option_id}}/image
Content-Type: multipart/form-data; boundary=WebAppBoundary
Authorization: Bearer {{admin_token}}

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="option.jpeg"
Content-Type: image/jpeg

< images/option.jpeg
--WebAppBoundary--

########################################################################
### Загрузить картинку к несуществующему варианту (ожидаем 404)
POST {{host}}/api/lessons/{{lesson_id}}/questions/{{question_id}}/options/999/image
Content-Type: multipart/form-data; boundary=WebAppBoundary
Authorization: Bearer {{admin_token}}

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="option.jpeg"
Content-Type: image/jpeg

< images/option.jpeg
--WebAppBoundary--


########################################################################
######################  КАРТИНКА И АУДИО СООБЩЕНИЯ  ###################
########################################################################

### Загрузить картинку к сообщению-объяснению
POST {{host}}/api/lessons/{{lesson_id}}/messages/{{message_id}}/image
Content-Type: multipart/form-data; boundary=WebAppBoundary
Authorization: Bearer {{admin_token}}

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="explain.jpeg"
Content-Type: image/jpeg

< images/explain.jpeg
--WebAppBoundary--

########################################################################
### Загрузить аудио к сообщению-объяснению
POST {{host}}/api/lessons/{{lesson_id}}/messages/{{message_id}}/audio
Content-Type: multipart/form-data; boundary=WebAppBoundary
Authorization: Bearer {{admin_token}}

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="explain.mp3"
Content-Type: audio/mpeg

< audio/explain.mp3
--WebAppBoundary--

########################################################################
### Загрузить картинку сообщению, которого не существует (ожидаем 404)
POST {{host}}/api/lessons/{{lesson_id}}/messages/999/image
Content-Type: multipart/form-data; boundary=WebAppBoundary
Authorization: Bearer {{admin_token}}

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="explain.jpeg"
Content-Type: image/jpeg

< images/explain.jpeg
--WebAppBoundary--

########################################################################
### Загрузить картинку сообщению без токена (ожидаем 401)
POST {{host}}/api/lessons/{{lesson_id}}/messages/{{message_id}}/image
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="explain.jpeg"
Content-Type: image/jpeg

< images/explain.jpeg
--WebAppBoundary--


########################################################################
### Проверить, что все медиа-ссылки появились в уроке
GET {{host}}/api/lessons/{{lesson_id}}
Accept: application/json
