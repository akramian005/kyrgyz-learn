@host = {{host}}
@course_id = 1
@user_course_id = 2

########################################################################
############################  СОЗДАНИЕ  ###############################
########################################################################

### Админ создаёт курс — тоже USER (официальные курсы лежат в файлах, см. content/official)
POST {{host}}/api/courses
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "title": "Кыргызский язык: базовый курс",
  "description": "Официальный курс от команды KyrgyzLearn",
  "position": 0
}

########################################################################
### Обычный юзер создаёт курс — должен стать USER, владелец = он сам
POST {{host}}/api/courses
Content-Type: application/json
Authorization: Bearer {{user_token}}

{
  "title": "Мой курс кыргызского для друзей",
  "description": "Персональная подборка уроков"
}


########################################################################
############################  ИЗМЕНЕНИЕ  ##############################
########################################################################

### Владелец меняет свой USER-курс — 200
PATCH {{host}}/api/courses/{{user_course_id}}
Content-Type: application/json
Authorization: Bearer {{user_token}}

{
  "description": "Обновлённое описание моего курса"
}

########################################################################
### Админ меняет OFFICIAL-курс — 200
PATCH {{host}}/api/courses/{{course_id}}
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "description": "Обновлённое описание официального курса"
}

########################################################################
############################  УДАЛЕНИЕ  ###############################
########################################################################

### Владелец удаляет свой курс
DELETE {{host}}/api/courses/{{user_course_id}}
Authorization: Bearer {{user_token}}

########################################################################

### Админ удаляет любой курс
DELETE {{host}}/api/courses/{{course_id}}
Authorization: Bearer {{admin_token}}